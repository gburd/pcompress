PROG= pcompress
SO_SUFFIX=@SO_SUFFIX@
LIB=libpcompress.$(SO_SUFFIX)
LINKLIB=pcompress
GCC=@GCC@
GPP=@GPP@
LIBVER=1
PC_VERSION=@PC_VERSION@
MAINSRCS = utils/utils.c allocator.c lzma_compress.c ppmd_compress.c \
	adaptive_compress.c lzfx_compress.c lz4_compress.c none_compress.c \
	utils/xxhash_base.c utils/heap.c utils/cpuid.c \
	utils/cpu_features.c utils/cpu_features_x86_64.c \
	utils/cpu_features_arm64.c utils/cpu_features_riscv.c \
	filters/analyzer/analyzer.c \
	meta_stream.c pcompress.c chunk.c idfilter.c manifest.c pz_crypt.c utils/pc_cache.c seek_index.c repair.c @PLATFORM_SRCS@
MAINHDRS = include/pcompress/pcompress.h allocator.h utils/pc_alloc.h utils/pc_cache.h pcompress.h  utils/utils.h utils/xxhash.h utils/heap.h \
	utils/cpuid.h utils/cpu_features.h utils/xxhash.h archive/pc_archive.h \
	filters/dispack/dis.hpp \
	meta_stream.h pz_crypt.h seek_index.h repair.h utils/binaryfusefilter.h filters/analyzer/analyzer.h
MAINOBJS = $(MAINSRCS:.c=.o)

PROGSRCS = main.c
PROGHDRS = pcompress.h  utils/utils.h
PROGOBJS = $(PROGSRCS:.c=.o)

XSALSA20_STREAM_C = crypto/xsalsa20/stream.c
XSALSA20_STREAM_ASM = crypto/xsalsa20/stream.s
XSALSA20_DEBUG = -DSALSA20_DEBUG

CRYPTO_SRCS = crypto/aes/crypto_aes.c crypto/scrypt/crypto_scrypt-nosse.c \
	crypto/scrypt/sha256.c crypto/scrypt/crypto_aesctr.c crypto/crypto_utils.c \
	crypto/sha2_utils.c crypto/sha3_utils.c crypto/xsalsa20/xsalsa20_xor.c \
	crypto/xsalsa20/hsalsa_core.c @XSALSA20_STREAM_C@ \
	crypto/aead.c crypto/monocypher/monocypher.c
CRYPTO_HDRS = crypto/crypto_utils.h crypto/aead.h crypto/monocypher/monocypher.h crypto/scrypt/crypto_scrypt.h \
	crypto/scrypt/sha256.h crypto/scrypt/crypto_aesctr.h crypto/aes/crypto_aes.h \
	crypto/sha2_utils.h crypto/sha3_utils.h crypto/xsalsa20/crypto_core_hsalsa20.h \
	crypto/xsalsa20/crypto_stream_salsa20.h crypto/xsalsa20/crypto_xsalsa20.h \
	$(MAINHDRS)
CRYPTO_ASM_SRCS = @AES_ASM_SRCS@ @XSALSA20_STREAM_ASM@
CRYPTO_ASM_OBJS = $(CRYPTO_ASM_SRCS:.s=.o)
CRYPTO_ASM_HDRS = crypto/aes/crypto_aes.h crypto/xsalsa20/crypto_stream_salsa20.h
CRYPTO_COMPAT_SRCS = crypto/old/sha2_utils_old.c crypto/old/sha3_utils_old.c
CRYPTO_COMPAT_HDRS = crypto/old/sha2_utils_old.h crypto/old/sha3_utils_old.h
CRYPTO_OBJS = $(CRYPTO_SRCS:.c=.o)
CRYPTO_COMPAT_OBJS = $(CRYPTO_COMPAT_SRCS:.c=.o)
CRYPTO_CPPFLAGS=-I@OPENSSL_INCDIR@

XXHASH_SRCS = utils/xxhash.c
XXHASH_SSE4_SRCS = utils/xxhash_sse4.c
XXHASH_SSE2_SRCS = utils/xxhash_sse2.c
XXHASH_NEON_SRCS = utils/xxhash_neon.c
XXHASH_AVX512_SRCS = utils/xxhash_avx512.c
XXHASH_OBJS = utils/xxhash_sse4.o utils/xxhash_sse2.o utils/xxhash_avx512.o utils/xxhash_neon.o
XXHASH_HDRS = utils/xxhash.h

BLAKE2b_SSE2 = crypto/blake2/blake2b_sse2.c
BLAKE2b_SSE3 = crypto/blake2/blake2b_ssse3.c
BLAKE2b_SSE4 = crypto/blake2/blake2b_sse41.c
BLAKE2b_AVX = crypto/blake2/blake2b_avx.c
BLAKE2bp_SSE2 = crypto/blake2/blake2bp_sse2.c
BLAKE2bp_SSE3 = crypto/blake2/blake2bp_ssse3.c
BLAKE2bp_SSE4 = crypto/blake2/blake2bp_sse41.c
BLAKE2bp_AVX = crypto/blake2/blake2bp_avx.c
BLAKE2b_AVX512 = crypto/blake2/blake2b_avx512.c
BLAKE2bp_AVX512 = crypto/blake2/blake2bp_avx512.c
BLAKE2b_NEON = crypto/blake2/blake2b_neon.c
BLAKE2bp_NEON = crypto/blake2/blake2bp_neon.c
BLAKE2_BASE_SRCS = crypto/blake2/blake2b.c crypto/blake2/blake2bp.c
BLAKE2_HDRS = crypto/blake2/blake2.h crypto/blake2/blake2-impl.h crypto/blake2/blake2-config.h \
	crypto/blake2/blake2-kat.h crypto/blake2/blake2b-round.h crypto/blake2/blake2b-load-sse2.h \
	crypto/blake2/blake2b-load-sse41.h crypto/blake2/blake2b-round-neon.h
BLAKE2_SRCS = $(BLAKE2b_SSE2) $(BLAKE2b_SSE3) $(BLAKE2b_SSE4) $(BLAKE2b_AVX) \
	$(BLAKE2b_AVX512) $(BLAKE2bp_SSE2) $(BLAKE2bp_SSE3) $(BLAKE2bp_SSE4) \
	$(BLAKE2bp_AVX) $(BLAKE2bp_AVX512) $(BLAKE2b_NEON) $(BLAKE2bp_NEON)
BLAKE2_OBJS = $(BLAKE2_SRCS:.c=.o)

# BLAKE3 1.8.7, unmodified (VENDOR_PATCHES.md). It dispatches at run time
# itself; ./config picks the SIMD files this architecture can build.
BLAKE3_BASE_SRCS = crypto/blake3/blake3.c crypto/blake3/blake3_dispatch.c \
	crypto/blake3/blake3_portable.c
BLAKE3_X86_SSE_SRCS = crypto/blake3/blake3_sse2.c crypto/blake3/blake3_sse41.c
BLAKE3_X86_SRCS = $(BLAKE3_X86_SSE_SRCS) crypto/blake3/blake3_avx2.c \
	crypto/blake3/blake3_avx512.c
BLAKE3_NEON_SRCS = crypto/blake3/blake3_neon.c
BLAKE3_SRCS = $(BLAKE3_BASE_SRCS) @BLAKE3_SIMD_SRCS@
BLAKE3_HDRS = crypto/blake3/blake3.h crypto/blake3/blake3_impl.h
BLAKE3_OBJS = $(BLAKE3_SRCS:.c=.o)

ZLIB_SRCS = zlib_compress.c
ZLIB_HDRS = $(MAINHDRS)
ZLIB_OBJS = $(ZLIB_SRCS:.c=.o)
ZLIB_CPPFLAGS = @LIBZ_INC@

BZLIB_SRCS = bzip2_compress.c
BZLIB_HDRS = $(MAINHDRS)
BZLIB_OBJS = $(BZLIB_SRCS:.c=.o)
BZLIB_CPPFLAGS = @LIBBZ2_INC@

EXTRA_CPPFLAGS = $(CRYPTO_CPPFLAGS) $(ZLIB_CPPFLAGS) $(BZLIB_CPPFLAGS)
EXTRA_LDFLAGS = @EXTRA_LD_FLAGS@

RABINSRCS = rabin/rabin_dedup.c rabin/global/index.c rabin/global/dedupe_config.c
RABINHDRS = rabin/rabin_dedup.h utils/utils.h rabin/global/index.h rabin/global/dedupe_config.h lzma/lzma_crc.h utils/qsort.h
RABINOBJS = $(RABINSRCS:.c=.o)

BSDIFFSRCS = bsdiff/bsdiff.c bsdiff/bspatch.c bsdiff/rle_encoder.c
BSDIFFHDRS = bsdiff/bscommon.h utils/utils.h allocator.h
BSDIFFOBJS = $(BSDIFFSRCS:.c=.o)

LZMASRCS = lzma/LzmaEnc.c lzma/LzFind.c lzma/LzmaDec.c lzma/Threads.c lzma/LzFindMt.c
LZMAHDRS = lzma/CpuArch.h lzma/LzFind.h lzma/LzmaEnc.h lzma/Types.h \
	lzma/LzHash.h lzma/LzmaDec.h utils/utils.h lzma/LzFindMt.h lzma/Threads.h lzma/Common/windows.h \
	lzma/Common/MyWindows.h lzma/Common/MyGuidDef.h lzma/Common/basetyps.h
LZMAOBJS = $(LZMASRCS:.c=.o)

LZFXSRCS = lzfx/lzfx.c
LZFXHDRS = lzfx/lzfx.h
LZFXOBJS = $(LZFXSRCS:.c=.o)

LZ4SRCS = lz4/lib/lz4.c lz4/lib/lz4hc.c
LZ4HDRS = lz4/lib/lz4.h lz4/lib/lz4hc.h
LZ4OBJS = $(LZ4SRCS:.c=.o)

ZSTDSRCS = zstd/lib/common/debug.c zstd/lib/common/entropy_common.c \
	zstd/lib/common/error_private.c zstd/lib/common/fse_decompress.c \
	zstd/lib/common/pool.c zstd/lib/common/threading.c \
	zstd/lib/common/xxhash.c zstd/lib/common/zstd_common.c \
	zstd/lib/compress/fse_compress.c zstd/lib/compress/hist.c \
	zstd/lib/compress/huf_compress.c zstd/lib/compress/zstd_compress.c \
	zstd/lib/compress/zstd_compress_literals.c \
	zstd/lib/compress/zstd_compress_sequences.c \
	zstd/lib/compress/zstd_compress_superblock.c \
	zstd/lib/compress/zstd_double_fast.c zstd/lib/compress/zstd_fast.c \
	zstd/lib/compress/zstd_lazy.c zstd/lib/compress/zstd_ldm.c \
	zstd/lib/compress/zstdmt_compress.c zstd/lib/compress/zstd_opt.c \
	zstd/lib/compress/zstd_preSplit.c \
	zstd/lib/decompress/huf_decompress.c \
	zstd/lib/decompress/zstd_ddict.c \
	zstd/lib/decompress/zstd_decompress_block.c \
	zstd/lib/decompress/zstd_decompress.c \
	zstd/lib/dictBuilder/cover.c zstd/lib/dictBuilder/divsufsort.c \
	zstd/lib/dictBuilder/fastcover.c zstd/lib/dictBuilder/zdict.c
ZSTD_ASM_SRCS = zstd/lib/decompress/huf_decompress_amd64.S
ZSTD_ASM_OBJS = $(ZSTD_ASM_SRCS:.S=.o)
ZSTDHDRS = zstd/lib/zstd.h
ZSTDOBJS = $(ZSTDSRCS:.c=.o)
ZSTDWRAP = zstd_compress.c
ZSTDWRAPOBJ = zstd_compress.o

PPMDSRCS = lzma/Ppmd8.c lzma/Ppmd8Enc.c lzma/Ppmd8Dec.c
PPMDHDRS = lzma/Ppmd.h lzma/Ppmd8.h
PPMDOBJS = $(PPMDSRCS:.c=.o)

CRCSRCS = lzma/crc64_fast.c lzma/crc64_table.c lzma/crc32_fast.c lzma/crc32_table.c
CRCHDRS = lzma/crc64_table_le.h lzma/crc64_table_be.h lzma/crc_macros.h \
	lzma/crc32_table_le.h lzma/crc32_table_be.h lzma/lzma_crc.h
CRCOBJS = $(CRCSRCS:.c=.o)

LZPSRCS = filters/lzp/lzp.c
LZPHDRS = filters/lzp/lzp.h
LZPOBJS = $(LZPSRCS:.c=.o)

DELTA2SRCS = filters/delta2/delta2.c
DELTA2HDRS = filters/delta2/delta2.h
DELTA2OBJS = $(DELTA2SRCS:.c=.o)

BCJSRCS = filters/bcj/bcj.c
BCJHDRS = filters/bcj/bcj.h
BCJOBJS = $(BCJSRCS:.c=.o)

ARCHIVESRCS = archive/pc_archive.c archive/pc_arc_filter.c utils/phash/phash.c \
	utils/phash/lookupa.c utils/phash/recycle.c
ARCHIVEHDRS = pcompress.h  utils/utils.h archive/pc_archive.h utils/phash/standard.h \
	filters/reflate/reflate.h utils/phash/lookupa.h utils/phash/recycle.h utils/phash/phash.h archive/pc_arc_filter.h \
	utils/phash/extensions.h filters/bcj/bcj.h
ARCHIVEOBJS = $(ARCHIVESRCS:.c=.o)

PJPGSRCS = filters/packjpg/aricoder.cpp filters/packjpg/bitops.cpp filters/packjpg/packjpg.cpp \
	 archive/pjpg_helper.cpp
PJPGHDRS = filters/packjpg/aricoder.h filters/packjpg/bitops.h filters/packjpg/dct8x8.h \
	filters/packjpg/packjpglib.h filters/packjpg/pjpgtbl.h
PJPGOBJS = $(PJPGSRCS:.cpp=.o)

PPNMSRCS = filters/packpnm/packpnm.cpp archive/ppnm_helper.cpp
PPNMHDRS = filters/packjpg/aricoder.h filters/packjpg/bitops.h filters/packpnm/ppnmbitlen.h \
	filters/packpnm/packpnmlib.h filters/packpnm/ppnmtbl.h
PPNMOBJS = $(PPNMSRCS:.cpp=.o)

WAVPKSRCS = archive/wavpack_helper.c
WAVPKOBJS = $(WAVPKSRCS:.c=.o)

DISPACKSRCS = filters/dispack/dis.cpp archive/dispack_helper.cpp
DISPACKHDRS = filters/dispack/dis.hpp filters/dispack/types.hpp
DISPACKOBJS = $(DISPACKSRCS:.cpp=.o)

# The reflate filter's pinned deflate: zlib 1.3.1, symbols prefixed pcz_
# (filters/reflate/zlib/zconf.h). reflate.c inflates with the system zlib.
REFLATESRCS = filters/reflate/reflate.c filters/reflate/rf_deflate.c
REFLATEZSRCS = filters/reflate/zlib/deflate.c filters/reflate/zlib/trees.c \
	filters/reflate/zlib/adler32.c filters/reflate/zlib/zutil.c
REFLATEHDRS = filters/reflate/reflate.h filters/reflate/rf_deflate.h \
	filters/reflate/zlib/zlib.h filters/reflate/zlib/zconf.h filters/reflate/zlib/deflate.h \
	filters/reflate/zlib/zutil.h filters/reflate/zlib/trees.h $(MAINHDRS)
REFLATEOBJS = $(REFLATESRCS:.c=.o)
REFLATEZOBJS = $(REFLATEZSRCS:.c=.o)

DICTSRCS = filters/dict/DictFilter.cpp
DICTHDRS = filters/dict/DictFilter.h filters/dict/Common.h
DICTOBJS = $(DICTSRCS:.cpp=.o)

SKEIN_BLOCK_C = crypto/skein/skein_block.c
SKEIN_BLOCK_ASM = crypto/skein/skein_block_x64.s
SKEIN_BLOCK_SRC = @SKEIN_BLOCK@
SKEIN_BLOCK_OBJ = crypto/skein/skein_block.o
SKEINSRCS = crypto/skein/SHA3api_ref.c crypto/skein/skein.c crypto/skein/skein_debug.c
SKEINHDRS = crypto/skein/brg_endian.h crypto/skein/SHA3api_ref.h \
	crypto/skein/skein.h crypto/skein/skein_port.h crypto/skein/brg_types.h \
	crypto/skein/skein_debug.h crypto/skein/skein_iv.h
SKEINOBJS = $(SKEINSRCS:.c=.o)

SHA2_SRCS = crypto/sha2/sha512.c
SHA2_HDRS = crypto/sha2/sha512.h
SHA2ASM_SRCS = crypto/sha2/intel/sha512_avx.asm crypto/sha2/intel/sha512_sse4.asm
SHA2ASM_OBJS = $(SHA2ASM_SRCS:.asm=.o)
SHA2_OBJS = $(SHA2_SRCS:.c=.o)

YASM = @YASM@
YASM_GAS = @YASM_GAS@
LIBBSCWRAP = libbsc_compress.c
LIBBSCWRAPOBJ = libbsc_compress.o
LIBBSCDIR = @LIBBSCDIR@
LIBBSCLFLAGS = -L$(LIBBSCDIR) -lbsc
LIBBSCLIB = @LIBBSCLIB@
LIBBSCGEN_OPT = @OMP_FLAGS@
LIBBSCCPPFLAGS = -I$(LIBBSCDIR)/libbsc -DENABLE_PC_LIBBSC

TRANSP_SRCS = filters/transpose/transpose.c
TRANSP_HDRS = filters/transpose/transpose.h
TRANSP_OBJS = $(TRANSP_SRCS:.c=.o)

KECCAK_SRC_COMMON = crypto/keccak/genKAT.c crypto/keccak/KeccakDuplex.c \
	crypto/keccak/KeccakNISTInterface.c crypto/keccak/KeccakSponge.c
KECCAK_SRC_OPT64 = $(KECCAK_SRC_COMMON) crypto/keccak/KeccakF-1600-opt64.c
KECCAK_SRC_OPT64_ASM1 = $(KECCAK_SRC_COMMON) crypto/keccak/KeccakF-1600-x86-64-asm.c
KECCAK_SRC_OPT64_ASM2 = crypto/keccak/KeccakF-1600-x86-64-gas.s
KECCAK_SRC_OPT64_ASM3 = crypto/keccak/KeccakF-1600-x86-64-gas_yasm.s
KECCAK_OBJS_OPT64_ASM2 = $(KECCAK_SRC_OPT64_ASM2:.s=.o)
KECCAK_OBJS_OPT64_ASM3 = $(KECCAK_SRC_OPT64_ASM3:.s=.o)

KECCAK_HDRS_COMMON = crypto/keccak/KeccakDuplex.h crypto/keccak/KeccakNISTInterface.h \
	crypto/keccak/KeccakSponge.h crypto/keccak/KeccakF-1600-interface.h
KECCAK_HDRS_OPT = $(KECCAK_HDRS_COMMON) \
	crypto/keccak/brg_endian.h crypto/keccak/KeccakF-1600-unrolling.macros
KECCAK_HDRS_OPT64 = $(KECCAK_HDRS_OPT)  crypto/keccak/KeccakF-1600-opt64-settings.h \
	crypto/keccak/KeccakF-1600-64.macros  crypto/keccak/KeccakF-1600-simd64.macros \
	crypto/keccak/KeccakF-1600-simd128.macros
KECCAK_HDRS_OPT64_ASM = $(KECCAK_HDRS_OPT64)

KECCAK_SRCS = @KECCAK_SRCS@
KECCAK_SRCS_ASM = @KECCAK_SRCS_ASM@
KECCAK_HDRS = @KECCAK_HDRS@
KECCAK_OBJS = $(KECCAK_SRCS:.c=.o)
KECCAK_OBJS_ASM = $(KECCAK_SRCS_ASM:.s=.o)

CRYPTO_ASM_COMPILE1 = $(COMPILE) $(GEN_OPT) $(CRYPTO_CPPFLAGS) $(CPPFLAGS)
CRYPTO_ASM_COMPILE2 = $(YASM_GAS)
CRYPTO_ASM_COMPILE = @CRYPTO_ASM_COMPILE@

BAKFILES = *~ lzma/*~ lzfx/*~ lz4/lib/*~ rabin/*~ bsdiff/*~ filters/lzp/*~ utils/*~ crypto/sha2/*~ \
	crypto/sha2/intel/*~ crypto/aes/*~ crypto/scrypt/*~ crypto/*~ rabin/global/*~ \
	delta2/*~ crypto/keccak/*~ transpose/*~ crypto/skein/*~ crypto/keccak/*.o \
	archive/*~ filters/delta2/*~ filters/bcj/*~ filters/packjpg/*~ filters/transpose/*~

RM = rm -f
RM_RF = rm -rf
BASE_CPPFLAGS = -I. -I./include -I./lzma -I./lzfx -I./lz4/lib @ZSTD_INCFLAGS@ -I./rabin -I./bsdiff -DNODEFAULT_PROPS \
	-D_FILE_OFFSET_BITS=64 -D_REENTRANT @SSE_INTRIN_FLAG@ -D_LZMA_PROB32 @ZSTD_CPPFLAGS@ \
	-I./filters/lzp @LIBBSCCPPFLAGS@ -I./crypto/skein -I./utils -I./crypto/sha2 \
	-I./crypto/scrypt -I./crypto/aes -I./crypto @KEYLEN@ -I./rabin/global \
	-I./crypto/keccak -I./filters/transpose -I./crypto/blake2 -I./crypto/blake3 $(EXTRA_CPPFLAGS) \
	-I./crypto/xsalsa20 -I./archive -pedantic -Wall -Wno-variadic-macros -I./filters -fno-strict-aliasing \
	-Wno-unused-but-set-variable -Wno-enum-compare -I./filters/analyzer -I./filters/dispack \
	@COMPAT_CPPFLAGS@ @XSALSA20_DEBUG@ -I@LIBARCHIVE_DIR@/libarchive -I./filters/packjpg \
	-I./filters/packpnm @ENABLE_WAVPACK@ $(PLATFORM_CPPFLAGS)
COMMON_CPPFLAGS = $(BASE_CPPFLAGS) -std=gnu99 $(PLATFORM_CINCLUDE)
COMMON_CPPFLAGS_cpp = $(BASE_CPPFLAGS)
COMMON_VEC_FLAGS = -ftree-vectorize
COMMON_LOOP_OPTFLAGS = $(VEC_FLAGS) @GCC_LOOP_FLAGS@
# Windows (MSYS2/MinGW-w64) only: the platform layer, utils/win32.h on
# every C and C++ compile and utils/win32 for the POSIX headers MinGW
# lacks. PC_OS is MINGW there and empty elsewhere.
PC_OS=@PC_OS@
EXEEXT=@EXEEXT@
PLATFORM_CPPFLAGS = @PLATFORM_CPPFLAGS@
PLATFORM_CINCLUDE = $(if $(PC_OS),-include utils/win32.h)
# Programs and tests: binary file I/O by default (utils/win32_binmode.c)
# and the UTF-8, long-path manifest (utils/win32_utf8.rc).
PROG_LDFLAGS = @PROG_LDFLAGS@
RPATH=@RPATH@
DTAGS=@DTAGS@
# The installed binary finds libpcompress.so.1 in $(PREFIX)/lib.
PROG_RPATH=@PROG_RPATH@
# Run paths for the dependency libraries (OpenSSL outside the default
# search path, e.g. /usr/openssl/3 or Homebrew); ./config --disable-rpath
# drops them for distribution packages, which link system libraries.
# ./config links the libraries it found into buildtmp/.
LDRPATHS = @LDRPATHS@
LDLIBS = @LDL@ -L./buildtmp -lbz2 -lz -lm @LIBBSCLFLAGS@ \
	-lcrypto @LRT@ -L@LIBARCHIVE_DIR@/.libs -larchive $(EXTRA_LDFLAGS) \
	-lpthread @OMP_LIBS@ @WAVPACK_LIBSPEC@ $(LDRPATHS)
OBJS = $(MAINOBJS) $(LZMAOBJS) $(PPMDOBJS) $(LZFXOBJS) $(LZ4OBJS) @ZSTD_OBJS@ $(ZSTD_ASM_OBJS) @ZSTD_WRAPOBJ@ $(CRCOBJS) \
$(RABINOBJS) $(BSDIFFOBJS) $(LZPOBJS) $(DELTA2OBJS) $(BCJOBJS) @LIBBSCWRAPOBJ@ $(SKEINOBJS) \
$(SKEIN_BLOCK_OBJ) @SHA2ASM_OBJS@ @SHA2_OBJS@ $(KECCAK_OBJS) $(KECCAK_OBJS_ASM) \
$(TRANSP_OBJS) $(CRYPTO_OBJS) $(ZLIB_OBJS) $(BZLIB_OBJS) $(XXHASH_OBJS) $(BLAKE2_OBJS) $(BLAKE3_OBJS) \
@CRYPTO_COMPAT_OBJS@ $(CRYPTO_ASM_OBJS) $(ARCHIVEOBJS) $(PJPGOBJS) $(DISPACKOBJS) $(PPNMOBJS) \
$(WAVPKOBJS) $(DICTOBJS) $(REFLATEOBJS) $(REFLATEZOBJS)

DEBUG_LINK = $(GPP) -pthread @LIBBSCGEN_OPT@ @EXTRA_OPT_FLAGS@ @OMP_FLAGS@ -fPIC
DEBUG_COMPILE = $(GCC) -g -c @EXTRA_OPT_FLAGS@ -fPIC @USE_CLANG_AS@
DEBUG_COMPILE_cpp = $(GPP) -g -c @EXTRA_OPT_FLAGS@ -fPIC @USE_CLANG_AS@
DEBUG_VEC_FLAGS =
DEBUG_LOOP_OPTFLAGS =
DEBUG_GEN_OPT = -O -fno-omit-frame-pointer @LIBBSCGEN_OPT@ @OMP_FLAGS@
DEBUG_CPPFLAGS = $(COMMON_CPPFLAGS)
DEBUG_FPTR_FLAG =

RELEASE_LINK = $(GPP) -pthread @LIBBSCGEN_OPT@ @EXTRA_OPT_FLAGS@ @OMP_FLAGS@ -fPIC
RELEASE_COMPILE = $(GCC) -c @EXTRA_OPT_FLAGS@ -fPIC -fvisibility=hidden @USE_CLANG_AS@
RELEASE_COMPILE_cpp = $(GPP) -c @EXTRA_OPT_FLAGS@ -fPIC -fvisibility=hidden @USE_CLANG_AS@
RELEASE_VEC_FLAGS = $(COMMON_VEC_FLAGS)
RELEASE_LOOP_OPTFLAGS = $(COMMON_LOOP_OPTFLAGS)
RELEASE_CPPFLAGS = $(COMMON_CPPFLAGS) -DNDEBUG
RELEASE_GEN_OPT = -O3 @LIBBSCGEN_OPT@ @OMP_FLAGS@
RELEASE_FPTR_FLAG = -fomit-frame-pointer

DEBUG_STATS_CPPFLAGS = -DDEBUG_STATS

LINK.PROG = @LINK@ $(PROG_LDFLAGS)
LINK.LIB = @LINK@ -shared
COMPILE = @COMPILE@
COMPILE_cpp = @COMPILE_cpp@
VEC_FLAGS = @VEC_FLAGS@
LOOP_OPTFLAGS = @LOOP_OPTFLAGS@
CPPFLAGS = @CPPFLAGS@ @DEBUG_STATS_CPPFLAGS@
GEN_OPT = @GEN_OPT@ @SSE_OPT_FLAGS@
BASE_OPT = @GEN_OPT@
PREFIX=@PREFIX@
# Where make install puts the library and libpcompress.pc (distros: lib64,
# lib/<multiarch>).
LIBDIR=$(PREFIX)/lib
AVX_OPT_FLAG = @AVX_OPT_FLAG@
SSE4_OPT_FLAG = @SSE4_OPT_FLAG@
SSE3_OPT_FLAG = @SSE3_OPT_FLAG@
SSE2_OPT_FLAG = @SSE2_OPT_FLAG@
AVX512_OPT_FLAG = @AVX512_OPT_FLAG@
AVX2_OPT_FLAG = @AVX2_OPT_FLAG@
NEON_OPT_FLAG = @NEON_OPT_FLAG@

SKEIN_FLAGS = $(GEN_OPT) $(VEC_FLAGS) $(CPPFLAGS) @FPTR_FLAG@
SHA2_FLAGS = $(GEN_OPT) $(VEC_FLAGS) $(CPPFLAGS) @FPTR_FLAG@
KECCAK_FLAGS = $(GEN_OPT) $(VEC_FLAGS) $(CPPFLAGS) @FPTR_FLAG@

all: $(PROG) buildtmp/rf_pdeflate

# test_reflate.sh builds its containers with the pinned deflate.
buildtmp/rf_pdeflate: test/tools/rf_pdeflate.c $(LIB)
	mkdir -p buildtmp
	$(COMPILE) $(GEN_OPT) $(CPPFLAGS) test/tools/rf_pdeflate.c -o buildtmp/rf_pdeflate.o
	$(LINK.PROG) -o $@ buildtmp/rf_pdeflate.o $(OBJS) $(LDLIBS)

$(LZMAOBJS): $(LZMASRCS) $(LZMAHDRS)
	$(COMPILE) $(GEN_OPT) $(CPPFLAGS) $(@:.o=.c) -o $@

$(CRCOBJS): $(CRCSRCS) $(CRCHDRS)
	$(COMPILE) $(GEN_OPT) $(VEC_FLAGS) $(CPPFLAGS) $(@:.o=.c) -o $@

$(PPMDOBJS): $(PPMDSRCS) $(PPMDHDRS)
	$(COMPILE) $(GEN_OPT) $(VEC_FLAGS) $(CPPFLAGS) $(@:.o=.c) -o $@

$(RABINOBJS): $(RABINSRCS) $(RABINHDRS)
	$(COMPILE) $(GEN_OPT) $(VEC_FLAGS) $(CPPFLAGS) $(@:.o=.c) -o $@

$(BSDIFFOBJS): $(BSDIFFSRCS) $(BSDIFFHDRS)
	$(COMPILE) $(GEN_OPT) $(VEC_FLAGS) $(CPPFLAGS) $(@:.o=.c) -o $@

$(LZFXOBJS): $(LZFXSRCS) $(LZFXHDRS)
	$(COMPILE) $(GEN_OPT) $(VEC_FLAGS) $(CPPFLAGS) $(@:.o=.c) -o $@

# lz4 allocates through LZ4_malloc()/LZ4_calloc()/LZ4_free() (allocator.c).
$(LZ4OBJS): $(LZ4SRCS) $(LZ4HDRS)
	$(COMPILE) $(GEN_OPT) $(VEC_FLAGS) $(CPPFLAGS) -DLZ4_USER_MEMORY_FUNCTIONS $(@:.o=.c) -o $@

$(ZSTDOBJS): $(ZSTDSRCS) $(ZSTDHDRS)
	$(COMPILE) $(GEN_OPT) $(VEC_FLAGS) -Izstd/lib -Izstd/lib/common $(CPPFLAGS) -DXXH_NAMESPACE=ZSTD_ -DZSTD_MULTITHREAD $(@:.o=.c) -o $@

$(ZSTD_ASM_OBJS): $(ZSTD_ASM_SRCS)
	$(GCC) -c -fPIC -Izstd/lib -Izstd/lib/common $(@:.o=.S) -o $@

$(ZSTDWRAPOBJ): $(ZSTDWRAP) $(ZSTDHDRS)
	$(COMPILE) $(GEN_OPT) $(VEC_FLAGS) $(CPPFLAGS) $(@:.o=.c) -o $@

$(LZPOBJS): $(LZPSRCS) $(LZPHDRS)
	$(COMPILE) $(GEN_OPT) $(VEC_FLAGS) $(CPPFLAGS) $(@:.o=.c) -o $@

$(DELTA2OBJS): $(DELTA2SRCS) $(DELTA2HDRS)
	$(COMPILE) $(GEN_OPT) $(VEC_FLAGS) $(CPPFLAGS) $(@:.o=.c) -o $@

$(BCJOBJS): $(BCJSRCS) $(BCJHDRS)
	$(COMPILE) $(GEN_OPT) $(VEC_FLAGS) $(CPPFLAGS) $(@:.o=.c) -o $@

$(ARCHIVEOBJS): $(ARCHIVESRCS) $(ARCHIVEHDRS)
	$(COMPILE) $(GEN_OPT) $(VEC_FLAGS) $(CPPFLAGS) $(@:.o=.c) -o $@

$(REFLATEOBJS): $(REFLATESRCS) $(REFLATEHDRS)
	$(COMPILE) $(GEN_OPT) $(CPPFLAGS) -DZ_SOLO $(@:.o=.c) -o $@

# Vendored code, built as zlib builds it: its own warnings are not ours.
$(REFLATEZOBJS): $(REFLATEZSRCS) $(REFLATEHDRS)
	$(COMPILE) $(GEN_OPT) -I./filters/reflate/zlib -DNO_GZIP -DZ_SOLO -w $(@:.o=.c) -o $@

$(PJPGOBJS): $(PJPGSRCS) $(PJPGHDRS)
	$(COMPILE_cpp) $(COMMON_VEC_FLAGS) @SSE_OPT_FLAGS@ @USE_CLANG_AS@ -O2 @GCC_SCHED_FLAGS@ \
	$(VEC_FLAGS) -DBUILD_LIB $(COMMON_CPPFLAGS_cpp) $(@:.o=.cpp) -o $@

$(PPNMOBJS): $(PPNMSRCS) $(PPNMHDRS)
	$(COMPILE_cpp) $(COMMON_VEC_FLAGS) @SSE_OPT_FLAGS@ @USE_CLANG_AS@ -O2 @GCC_SCHED_FLAGS@ \
	$(VEC_FLAGS) -DBUILD_LIB $(COMMON_CPPFLAGS_cpp) $(@:.o=.cpp) -o $@

$(WAVPKOBJS): $(WAVPKSRCS)
	[ "x@ENABLE_WAVPACK@" != "x" ] && (cd @WAVPACK_DIR@; make)
	if [ "x@ENABLE_WAVPACK@" != "x" ]; then \
	    $(COMPILE) $(GEN_OPT) $(VEC_FLAGS) $(CPPFLAGS) -I@WAVPACK_DIR@/include $(@:.o=.c) -o $@; \
	else \
	    $(COMPILE) $(GEN_OPT) $(VEC_FLAGS) $(CPPFLAGS) $(@:.o=.c) -o $@; \
	fi

$(DISPACKOBJS): $(DISPACKSRCS) $(DISPACKHDRS)
	$(COMPILE_cpp) $(COMMON_VEC_FLAGS) @DEBUG_STATS_CPPFLAGS@ @SSE_OPT_FLAGS@ @USE_CLANG_AS@ -O2 @GCC_SCHED_FLAGS@ \
	-Wno-variadic-macros $(VEC_FLAGS) $(COMMON_CPPFLAGS_cpp) $(@:.o=.cpp) -o $@

$(DICTOBJS): $(DICTSRCS) $(DICTHDRS)
	$(COMPILE_cpp) $(COMMON_VEC_FLAGS) @DEBUG_STATS_CPPFLAGS@ @SSE_OPT_FLAGS@ @USE_CLANG_AS@ -O2 @GCC_SCHED_FLAGS@ \
	-Wno-variadic-macros $(VEC_FLAGS) $(COMMON_CPPFLAGS_cpp) $(@:.o=.cpp) -o $@

$(SKEIN_BLOCK_OBJ): $(SKEIN_BLOCK_SRC)
	$(COMPILE) $(SKEIN_FLAGS) @GNU_AS_FLAG@ $(SKEIN_BLOCK_SRC) -o $@

$(SKEINOBJS): $(SKEINSRCS) $(SKEINHDRS)
	$(COMPILE) $(SKEIN_FLAGS) $(@:.o=.c) -o $@

# The Intel SSE4/AVX SHA-512 assembly is only linked when yasm is available.
$(SHA2_OBJS): $(SHA2_SRCS) $(SHA2_HDRS)
	$(COMPILE) $(SHA2_FLAGS) `[ -n "@SHA2ASM_OBJS@" ] && echo -DHAVE_SHA512_ASM` $(@:.o=.c) -o $@

$(SHA2ASM_OBJS): $(SHA2ASM_SRCS)
	$(YASM)	-o $@ $(@:.o=.asm)

$(KECCAK_OBJS): $(KECCAK_SRCS) $(KECCAK_HDRS)
	$(COMPILE) $(KECCAK_FLAGS) $(@:.o=.c) -o $@

$(KECCAK_OBJS_OPT64_ASM2): $(KECCAK_SRC_OPT64_ASM2)
	$(COMPILE) $(KECCAK_FLAGS) @GNU_AS_FLAG@ $(@:.o=.s) -o $@

$(KECCAK_OBJS_OPT64_ASM3): $(KECCAK_SRC_OPT64_ASM3)
	$(YASM_GAS) $(@:.o=.s) -o $@

$(KECCAK_OBJS_ASM): $(KECCAK_SRCS_ASM) $(KECCAK_HDRS)

$(LIBBSCWRAPOBJ): $(LIBBSCWRAP)
	$(COMPILE) $(GEN_OPT) $(VEC_FLAGS) $(CPPFLAGS) $(@:.o=.c) -o $@

$(TRANSP_OBJS): $(TRANSP_SRCS) $(TRANSP_HDRS)
	$(COMPILE) $(GEN_OPT) $(VEC_FLAGS) $(CPPFLAGS) $(@:.o=.c) -o $@

$(CRYPTO_OBJS): $(CRYPTO_SRCS) $(CRYPTO_HDRS) $(CRYPTO_ASM_OBJS)
	$(COMPILE) $(GEN_OPT) $(CRYPTO_CPPFLAGS) $(CPPFLAGS) $(@:.o=.c) -o $@

$(CRYPTO_ASM_OBJS): $(CRYPTO_ASM_SRCS) $(CRYPTO_ASM_HDRS)
	$(CRYPTO_ASM_COMPILE) @GNU_AS_FLAG@ -o $@ $(@:.o=.s)

$(CRYPTO_COMPAT_OBJS): $(CRYPTO_COMPAT_SRCS) $(CRYPTO_COMPAT_HDRS)
	$(COMPILE) $(GEN_OPT) $(CRYPTO_CPPFLAGS) $(CPPFLAGS) $(@:.o=.c) -o $@

$(ZLIB_OBJS): $(ZLIB_SRCS) $(ZLIB_HDRS)
	$(COMPILE) $(GEN_OPT) $(ZLIB_CPPFLAGS) $(CPPFLAGS) $(@:.o=.c) -o $@

$(BZLIB_OBJS): $(BZLIB_SRCS) $(BZLIB_HDRS)
	$(COMPILE) $(GEN_OPT) $(BZLIB_CPPFLAGS) $(CPPFLAGS) $(@:.o=.c) -o $@

$(XXHASH_OBJS): $(XXHASH_SSE4_SRCS) $(XXHASH_SSE2_SRCS) $(XXHASH_AVX512_SRCS) $(XXHASH_NEON_SRCS) $(XXHASH_HDRS) $(XXHASH_SRCS)
	$(COMPILE) $(BASE_OPT) $(SSE4_OPT_FLAG) $(CPPFLAGS) $(XXHASH_SSE4_SRCS) -o $(XXHASH_SSE4_SRCS:.c=.o)
	$(COMPILE) $(BASE_OPT) $(SSE2_OPT_FLAG) $(CPPFLAGS) $(XXHASH_SSE2_SRCS) -o $(XXHASH_SSE2_SRCS:.c=.o)
	$(COMPILE) $(BASE_OPT) $(AVX512_OPT_FLAG) $(CPPFLAGS) $(XXHASH_AVX512_SRCS) -o $(XXHASH_AVX512_SRCS:.c=.o)
	$(COMPILE) $(BASE_OPT) $(NEON_OPT_FLAG) $(CPPFLAGS) $(XXHASH_NEON_SRCS) -o $(XXHASH_NEON_SRCS:.c=.o)

$(BLAKE2_OBJS): $(BLAKE2_SRCS) $(BLAKE2_BASE_SRCS) $(BLAKE2_HDRS)
	$(COMPILE) $(BASE_OPT) $(SSE2_OPT_FLAG) $(CPPFLAGS) $(BLAKE2b_SSE2) -o $(BLAKE2b_SSE2:.c=.o)
	$(COMPILE) $(BASE_OPT) $(SSE3_OPT_FLAG) $(CPPFLAGS) $(BLAKE2b_SSE3) -o $(BLAKE2b_SSE3:.c=.o)
	$(COMPILE) $(BASE_OPT) $(SSE4_OPT_FLAG) $(CPPFLAGS) $(BLAKE2b_SSE4) -o $(BLAKE2b_SSE4:.c=.o)
	$(COMPILE) $(BASE_OPT) $(AVX_OPT_FLAG) $(CPPFLAGS) $(BLAKE2b_AVX) -o $(BLAKE2b_AVX:.c=.o)
	$(COMPILE) $(BASE_OPT) $(SSE2_OPT_FLAG) $(CPPFLAGS) $(BLAKE2bp_SSE2) -o $(BLAKE2bp_SSE2:.c=.o)
	$(COMPILE) $(BASE_OPT) $(SSE3_OPT_FLAG) $(CPPFLAGS) $(BLAKE2bp_SSE3) -o $(BLAKE2bp_SSE3:.c=.o)
	$(COMPILE) $(BASE_OPT) $(SSE4_OPT_FLAG) $(CPPFLAGS) $(BLAKE2bp_SSE4) -o $(BLAKE2bp_SSE4:.c=.o)
	$(COMPILE) $(BASE_OPT) $(AVX_OPT_FLAG) $(CPPFLAGS) $(BLAKE2bp_AVX) -o $(BLAKE2bp_AVX:.c=.o)
	$(COMPILE) $(BASE_OPT) $(AVX512_OPT_FLAG) $(CPPFLAGS) $(BLAKE2b_AVX512) -o $(BLAKE2b_AVX512:.c=.o)
	$(COMPILE) $(BASE_OPT) $(AVX512_OPT_FLAG) $(CPPFLAGS) $(BLAKE2bp_AVX512) -o $(BLAKE2bp_AVX512:.c=.o)
	$(COMPILE) $(BASE_OPT) $(NEON_OPT_FLAG) $(CPPFLAGS) $(BLAKE2b_NEON) -o $(BLAKE2b_NEON:.c=.o)
	$(COMPILE) $(BASE_OPT) $(NEON_OPT_FLAG) $(CPPFLAGS) $(BLAKE2bp_NEON) -o $(BLAKE2bp_NEON:.c=.o)

# gnu11: blake3_dispatch.c uses C11 atomics for its CPU feature cache.
BLAKE3_COMPILE = $(COMPILE) $(BASE_OPT) $(CPPFLAGS) -std=gnu11
$(BLAKE3_OBJS): $(BLAKE3_HDRS)
crypto/blake3/blake3.o crypto/blake3/blake3_dispatch.o crypto/blake3/blake3_portable.o \
crypto/blake3/blake3_neon.o: %.o: %.c
	$(BLAKE3_COMPILE) $< -o $@
crypto/blake3/blake3_sse2.o: crypto/blake3/blake3_sse2.c
	$(BLAKE3_COMPILE) $(SSE2_OPT_FLAG) $< -o $@
crypto/blake3/blake3_sse41.o: crypto/blake3/blake3_sse41.c
	$(BLAKE3_COMPILE) $(SSE4_OPT_FLAG) $< -o $@
crypto/blake3/blake3_avx2.o: crypto/blake3/blake3_avx2.c
	$(BLAKE3_COMPILE) $(AVX2_OPT_FLAG) $< -o $@
crypto/blake3/blake3_avx512.o: crypto/blake3/blake3_avx512.c
	$(BLAKE3_COMPILE) $(AVX512_OPT_FLAG) $< -o $@

$(MAINOBJS): $(MAINSRCS) $(MAINHDRS)
	$(COMPILE) $(GEN_OPT) $(LOOP_OPTFLAGS) $(CPPFLAGS) $(@:.o=.c) -o $@

$(PROGOBJS): $(PROGSRCS) $(PROGHDRS)
	$(COMPILE) $(GEN_OPT) $(LOOP_OPTFLAGS) $(CPPFLAGS) $(@:.o=.c) -o $@

utils/win32_binmode.o: utils/win32_binmode.c
	$(COMPILE) $(GEN_OPT) $(CPPFLAGS) $(@:.o=.c) -o $@

utils/win32_utf8.o: utils/win32_utf8.rc utils/win32_utf8.manifest
	windres -O coff -o $@ utils/win32_utf8.rc

# A stamp, not a phony target: a phony prerequisite made $(LIB) relink on
# every make invocation, e.g. under 'make -j check' while tests ran it.
LIBARCHIVE_A = @LIBARCHIVE_DIR@/.libs/libarchive.a
Libarchive: $(LIBARCHIVE_A)

# Rebuilt when the pcompress patch changes (./config applies new parts).
$(LIBARCHIVE_A): archive/patches/pcompress_libarchive.patch
	(cd @LIBARCHIVE_DIR@; $(MAKE))

LIBBSC_CPP_SRCS = $(LIBBSCDIR)/libbsc/adler32/adler32.cpp \
	$(LIBBSCDIR)/libbsc/bwt/bwt.cpp \
	$(LIBBSCDIR)/libbsc/coder/coder.cpp \
	$(LIBBSCDIR)/libbsc/coder/qlfc/qlfc.cpp \
	$(LIBBSCDIR)/libbsc/coder/qlfc/qlfc_model.cpp \
	$(LIBBSCDIR)/libbsc/filters/detectors.cpp \
	$(LIBBSCDIR)/libbsc/filters/preprocessing.cpp \
	$(LIBBSCDIR)/libbsc/libbsc/libbsc.cpp \
	$(LIBBSCDIR)/libbsc/lzp/lzp.cpp \
	$(LIBBSCDIR)/libbsc/platform/platform.cpp \
	$(LIBBSCDIR)/libbsc/st/st.cpp
LIBBSC_C_SRCS = $(LIBBSCDIR)/libbsc/bwt/libsais/libsais.c
LIBBSC_CPP_OBJS = $(LIBBSC_CPP_SRCS:.cpp=.o)
LIBBSC_C_OBJS = $(LIBBSC_C_SRCS:.c=.o)

$(LIBBSC_CPP_OBJS): $(LIBBSC_CPP_SRCS)
	$(GPP) -c -O3 @SSE_OPT_FLAGS@ @USE_CLANG_AS@ -fPIC @BSC_ENDIAN_FLAG@ -DLIBBSC_SORT_TRANSFORM_SUPPORT @LIBBSCGEN_OPT@ \
	-I$(LIBBSCDIR)/libbsc $(@:.o=.cpp) -o $@

$(LIBBSC_C_OBJS): $(LIBBSC_C_SRCS)
	$(GCC) -c -O3 @SSE_OPT_FLAGS@ @USE_CLANG_AS@ -fPIC @BSC_ENDIAN_FLAG@ \
	-I$(LIBBSCDIR)/libbsc $(@:.o=.c) -o $@

$(LIBBSCLIB): $(LIBBSC_CPP_OBJS) $(LIBBSC_C_OBJS)
	@AR@ rcs $@ $(LIBBSC_CPP_OBJS) $(LIBBSC_C_OBJS)

ifeq ($(PC_OS),MINGW)
# Windows: the DLL sits next to the programs that load it (buildtmp/ here,
# bin/ when installed), and -lpcompress links its import library, $(LIB).
# It exports the libpcompress.map names (./config writes libpcompress.def).
DLL = libpcompress-$(LIBVER).dll
# Every program links PROG_LDFLAGS and needs $(LIB) first: build it here.
$(LIB): $(LIBARCHIVE_A) $(OBJS)  $(LIBBSCLIB) libpcompress.map $(PROG_LDFLAGS)
	mkdir -p buildtmp
	$(LINK.LIB) -o buildtmp/$(DLL) -Wl,--out-implib,$(LIB) $(OBJS) $(LDLIBS) @EXPORT_FLAGS@
else
# libpcompress.map lists the exported API (version node PCOMPRESS_1);
# everything else, including the bundled libraries, is local.
$(LIB): $(LIBARCHIVE_A) $(OBJS)  $(LIBBSCLIB) libpcompress.map
	$(LINK.LIB) -Wl,-soname$(LIB).$(LIBVER) -o $(LIB).$(LIBVER) $(OBJS) $(LDLIBS) @EXPORT_FLAGS@
	ln -sf $(LIB).$(LIBVER) $(LIB)
endif

./buildtmp/$(PROG): $(LIB) $(PROGOBJS)
	mkdir -p buildtmp
	$(LINK.PROG) -o $@ $(PROGOBJS) $(LDLIBS) -L. -l$(LINKLIB) $(PROG_RPATH)

# A self-contained binary: the library objects linked in, -static.
# Fully static only where the libc allows it (musl; see packaging/).
static: buildtmp/$(PROG)-static
buildtmp/$(PROG)-static: $(LIBARCHIVE_A) $(OBJS) $(LIBBSCLIB) $(PROGOBJS)
	mkdir -p buildtmp
	$(LINK.PROG) -static -o $@ $(PROGOBJS) $(OBJS) $(LDLIBS)

$(PROG): ./buildtmp/$(PROG)
	cat utils/pcompress.sh | sed "s#<PC_PATH>#`pwd`#" > pcompress
	chmod +x pcompress

test: all
	(cd test; ulimit -c unlimited; sh ./run_test.sh $(TESTSUITE) ) 2>&1 | tee test.log

# --- Enhanced Test Framework Targets ---

TEST_CPPFLAGS = $(COMMON_CPPFLAGS) -I./test/unit -I./filters/dict
UNIT_TESTS = test_compress test_xxhash test_crc test_slab test_sem test_blake2 test_blake3 test_sha2 test_api test_filters test_crypto test_algos test_reentrant test_seek_index test_repair test_reflate
# Tests link the objects directly: the shared library hides internal symbols.
# LINK.PROG carries the same LTO/OpenMP/linker flags as the real binary.

test-unit-build: $(LIB)
	@for t in $(UNIT_TESTS); do \
		echo "  BUILD buildtmp/$$t"; \
		$(COMPILE) $(GEN_OPT) $(TEST_CPPFLAGS) test/unit/$$t.c -o buildtmp/$$t.o && \
		$(LINK.PROG) -o buildtmp/$$t buildtmp/$$t.o $(OBJS) $(LDLIBS) || exit 1; \
	done

# Public-API test: only include/ on the include path, linked against the
# shared library like any other program.
PUBLIC_TESTS = test_public test_chunk test_manifest test_alloc
$(PUBLIC_TESTS:%=buildtmp/%): buildtmp/%: test/unit/%.c include/pcompress/pcompress.h $(LIB)
	mkdir -p buildtmp
	$(COMPILE) $(GEN_OPT) -Iinclude -I./test/unit test/unit/$*.c -o buildtmp/$*.o
	$(LINK.PROG) -o $@ buildtmp/$*.o -L. -l$(LINKLIB) $(PROG_RPATH) @TEST_RPATH@

# TEST_WRAPPER runs each unit test, e.g. "sh ci/watchdog.sh 600" in CI.
test-unit: test-unit-build $(PUBLIC_TESTS:%=buildtmp/%)
	@for t in $(UNIT_TESTS) $(PUBLIC_TESTS); do $(TEST_WRAPPER) buildtmp/$$t || { echo "FAILED: buildtmp/$$t (exit $$?)"; exit 1; }; done

test-integration: all
	(cd test; sh run_all_tests.sh integration)

# ABI check (libabigail): compare the shared library's public ABI with
# abi/libpcompress.abi. Needs a build with debug info (CFLAGS=-g). Fails on
# an incompatible change (removed or changed function, changed type); adding
# functions is allowed. After an intended change: make abi-update.
abi-check: $(LIB)
	abidw --headers-dir include/pcompress --drop-private-types --drop-undefined-syms --exported-interfaces-only \
	    --out-file buildtmp/libpcompress.abi $(LIB).$(LIBVER)
	abidiff --no-added-syms --drop-private-types --suppressions abi/suppressions.ini \
	    abi/libpcompress.abi buildtmp/libpcompress.abi

abi-update: $(LIB)
	abidw --headers-dir include/pcompress --drop-private-types --drop-undefined-syms --exported-interfaces-only \
	    --out-file abi/libpcompress.abi $(LIB).$(LIBVER)

# What packagers run: fast, no network, no root. Sequential: under make -j
# the two would relink/rebuild the library while the other is running it.
# The example backup tool, end to end, against the library just built.
buildtmp/pcbackup: examples/backup/pcbackup.c include/pcompress/pcompress.h $(LIB)
	mkdir -p buildtmp
	$(COMPILE) $(GEN_OPT) -Iinclude examples/backup/pcbackup.c -o buildtmp/pcbackup.o
	$(LINK.PROG) -o $@ buildtmp/pcbackup.o -L. -l$(LINKLIB) $(PROG_RPATH) @TEST_RPATH@

ifeq ($(PC_OS),MINGW)
test-examples:
	@echo "SKIP: test-examples: examples/backup uses POSIX file APIs (symlinks, O_NOFOLLOW, utimensat) that Windows lacks"
else
test-examples: buildtmp/pcbackup
	sh examples/backup/test.sh "$$PWD/buildtmp/pcbackup"
endif

# Reference .pz files from earlier releases must keep decompressing.
test-backward-compat: all
	sh test/backward_compat/run_backward_compat.sh --verify-reference

check:
	$(MAKE) test-unit
	$(MAKE) test-integration
	$(MAKE) test-backward-compat
	$(MAKE) test-examples

test-all: all test-unit-build
	(cd test; sh run_all_tests.sh all)

test-full: all test-unit-build bench-build
	(cd test; sh run_all_tests.sh full)

bench-build: $(LIB)
	$(COMPILE) $(GEN_OPT) $(TEST_CPPFLAGS) test/performance/bench_algos.c -o buildtmp/bench_algos.o
	$(LINK.PROG) -o buildtmp/bench_algos buildtmp/bench_algos.o $(OBJS) $(LDLIBS)

# Coverage of project-owned code (configure with --enable-coverage).
# Third-party trees (lz4, zstd, bsc, libarchive, LZMA SDK, crypto
# reference code, packJPG/packPNM/dispack/dict) are excluded.
COV_EXCLUDE = '*/lz4/*' '*/zstd/*' '*/bsc/*' '*/archive/libarchive/*' \
	'*/lzma/*' '*/crypto/blake2/*' '*/crypto/blake3/*' '*/crypto/keccak/*' '*/crypto/skein/*' \
	'*/crypto/sha2/*' '*/crypto/aes/*' '*/crypto/scrypt/*' '*/crypto/xsalsa20/*' \
	'*/crypto/old/*' '*/utils/phash/*' '*/filters/packjpg/*' '*/filters/packpnm/*' \
	'*/filters/dispack/*' '*/filters/dict/*' '*/filters/reflate/zlib/*' '*/test/*' '/nix/*' '/usr/*'
coverage: all test-unit-build
	lcov -q --zerocounters --directory .
	-$(MAKE) test-unit
	-(cd test; sh run_all_tests.sh integration)
	-sh test/feature_matrix.sh "`pwd`/pcompress" "`pwd`/buildtmp/matrix" quick
	lcov -q --capture --directory . --output-file coverage.info \
		--rc branch_coverage=1 --ignore-errors mismatch,negative,inconsistent,unused,empty
	lcov -q --remove coverage.info $(COV_EXCLUDE) --output-file coverage.info \
		--rc branch_coverage=1 --ignore-errors unused,empty
	lcov --summary coverage.info --rc branch_coverage=1

bench: bench-build buildtmp/bench_chunk
	buildtmp/bench_algos
	buildtmp/bench_chunk

# The chunk-store pipeline, through the public API like any other program.
buildtmp/bench_chunk: test/performance/bench_chunk.c include/pcompress/pcompress.h $(LIB)
	mkdir -p buildtmp
	$(COMPILE) $(GEN_OPT) -Iinclude test/performance/bench_chunk.c -o buildtmp/bench_chunk.o
	$(LINK.PROG) -o $@ buildtmp/bench_chunk.o -L. -l$(LINKLIB) $(PROG_RPATH) @TEST_RPATH@

fuzz-build: $(LIB)
	@echo "Building fuzz harnesses (requires clang with libFuzzer or AFL++)..."
	@if command -v clang >/dev/null 2>&1; then \
		clang -fsanitize=fuzzer,address -o buildtmp/fuzz_decompress \
			$(TEST_CPPFLAGS) test/fuzz/fuzz_decompress.c $(OBJS) $(LDLIBS) -lstdc++ @OMP_FLAGS@ @OMP_LIBS@; \
		clang -fsanitize=fuzzer,address -o buildtmp/fuzz_crc \
			$(TEST_CPPFLAGS) test/fuzz/fuzz_crc.c $(OBJS) $(LDLIBS) -lstdc++ @OMP_FLAGS@ @OMP_LIBS@; \
		clang -fsanitize=fuzzer,address -o buildtmp/fuzz_compress \
			$(TEST_CPPFLAGS) test/fuzz/fuzz_compress.c $(OBJS) $(LDLIBS) -lstdc++ @OMP_FLAGS@ @OMP_LIBS@; \
		clang -fsanitize=fuzzer,address -o buildtmp/fuzz_seek_index \
			$(TEST_CPPFLAGS) test/fuzz/fuzz_seek_index.c $(OBJS) $(LDLIBS) -lstdc++ @OMP_FLAGS@ @OMP_LIBS@; \
		clang -fsanitize=fuzzer,address -o buildtmp/fuzz_repair \
			$(TEST_CPPFLAGS) test/fuzz/fuzz_repair.c $(OBJS) $(LDLIBS) -lstdc++ @OMP_FLAGS@ @OMP_LIBS@; \
		clang -fsanitize=fuzzer,address -o buildtmp/fuzz_reflate \
			$(TEST_CPPFLAGS) test/fuzz/fuzz_reflate.c $(OBJS) $(LDLIBS) -lstdc++ @OMP_FLAGS@ @OMP_LIBS@; \
		clang -fsanitize=fuzzer,address -o buildtmp/fuzz_dedupe \
			$(TEST_CPPFLAGS) test/fuzz/fuzz_dedupe.c $(OBJS) $(LDLIBS) -lstdc++ @OMP_FLAGS@ @OMP_LIBS@; \
		for t in fuzz_chunk fuzz_manifest; do \
			clang -fsanitize=fuzzer,address -g -Iinclude -o buildtmp/$$t test/fuzz/$$t.c \
				-L. -l$(LINKLIB) $(PROG_RPATH) @TEST_RPATH@ || exit 1; \
		done; \
		clang -fsanitize=address -g -Iinclude -o buildtmp/fuzz_seeds test/fuzz/seeds.c \
			-L. -l$(LINKLIB) $(PROG_RPATH) @TEST_RPATH@ && \
		mkdir -p buildtmp/fuzz-seeds/chunk buildtmp/fuzz-seeds/manifest \
		    buildtmp/fuzz-seeds/seek_index buildtmp/fuzz-seeds/reflate buildtmp/fuzz-seeds/dedupe && \
		python3 test/tools/reflate_seeds.py buildtmp/fuzz-seeds/reflate && \
		ASAN_OPTIONS=detect_leaks=0 buildtmp/fuzz_seeds buildtmp/fuzz-seeds || exit 1; \
	else \
		echo "SKIP: clang not found; fuzz harnesses require clang with libFuzzer support"; \
	fi

fuzz: fuzz-build
	@echo "Run individual fuzz targets manually:"
	@echo "  buildtmp/fuzz_decompress -max_total_time=60"
	@echo "  buildtmp/fuzz_compress -max_total_time=60"
	@echo "  buildtmp/fuzz_crc -max_total_time=60"
	@echo "  buildtmp/fuzz_seek_index -max_total_time=60 corpus/ buildtmp/fuzz-seeds/seek_index"
	@echo "  buildtmp/fuzz_repair -max_total_time=60 corpus/"
	@echo "  buildtmp/fuzz_reflate -max_total_time=60 corpus/ buildtmp/fuzz-seeds/reflate"
	@echo "  buildtmp/fuzz_dedupe -max_total_time=60 corpus/ buildtmp/fuzz-seeds/dedupe"
	@echo "  buildtmp/fuzz_chunk -max_total_time=60 corpus/ buildtmp/fuzz-seeds/chunk"
	@echo "  buildtmp/fuzz_manifest -max_total_time=60 corpus/ buildtmp/fuzz-seeds/manifest"

topclean:
	$(RM) buildtmp/$(PROG) $(OBJS) $(PROGOBJS) $(BAKFILES) $(LIB) $(LIB).$(LIBVER) $(PROG_LDFLAGS)
	$(RM) $(LIBBSC_CPP_OBJS) $(LIBBSC_C_OBJS) $(LIBBSCLIB)
	$(RM) buildtmp/test_* buildtmp/bench_algos* buildtmp/bench_chunk* buildtmp/rf_pdeflate*
	$(RM) buildtmp/fuzz_decompress buildtmp/fuzz_crc buildtmp/fuzz_compress buildtmp/fuzz_seek_index
	$(RM) buildtmp/fuzz_repair buildtmp/fuzz_reflate buildtmp/fuzz_dedupe
	$(RM) buildtmp/fuzz_chunk buildtmp/fuzz_manifest buildtmp/fuzz_seeds
	$(RM_RF) buildtmp/fuzz-seeds
	$(RM) test.log
	$(RM_RF) test/datafiles test/integration/datafiles

clean: topclean
	(cd @LIBARCHIVE_DIR@; make clean)
	[ "x@ENABLE_WAVPACK@" != "x" ] && (cd @WAVPACK_DIR@; make clean)
	exit 0

distclean: clean
	$(RM) Makefile libpcompress.exports libpcompress.def
	$(RM) $(LIBBSC_CPP_OBJS) $(LIBBSC_C_OBJS) $(LIBBSCLIB)
	$(RM_RF) buildtmp
	(cd @LIBARCHIVE_DIR@; make distclean; rm -rf Makefile.orig tar test test_utils cpio libarchive/test)
	[ "x@ENABLE_WAVPACK@" != "x" ] && (cd @WAVPACK_DIR@; make distclean)
	exit 0

install: $(PROG)
	@mkdir -p $(DESTDIR)$(PREFIX)/bin
	@chmod 0755 $(DESTDIR)$(PREFIX)/bin
	@cp buildtmp/$(PROG)$(EXEEXT) $(DESTDIR)$(PREFIX)/bin
	@chmod 0555 $(DESTDIR)$(PREFIX)/bin/$(PROG)$(EXEEXT)

	@mkdir -p $(DESTDIR)$(LIBDIR)
	@chmod 0755 $(DESTDIR)$(LIBDIR)
ifeq ($(PC_OS),MINGW)
	@cp buildtmp/$(DLL) $(DESTDIR)$(PREFIX)/bin
	@cp $(LIB) $(DESTDIR)$(LIBDIR)
else
	@cp $(LIB).$(LIBVER) $(DESTDIR)$(LIBDIR)
	@chmod 0555 $(DESTDIR)$(LIBDIR)/$(LIB).$(LIBVER)
	@ln -sf $(LIB).$(LIBVER) $(DESTDIR)$(LIBDIR)/$(LIB)
endif

	@mkdir -p $(DESTDIR)$(PREFIX)/include/pcompress $(DESTDIR)$(LIBDIR)/pkgconfig
	@cp include/pcompress/pcompress.h $(DESTDIR)$(PREFIX)/include/pcompress/
	@chmod 0444 $(DESTDIR)$(PREFIX)/include/pcompress/pcompress.h
	@# Written here, not by ./config: 'make install PREFIX=...' may differ.
	@sed -e 's#%PREFIX%#$(PREFIX)#' -e 's#%LIBDIR%#$(LIBDIR)#' -e 's#%VERSION%#$(PC_VERSION)#' \
	    pkgconfig/libpcompress.pc.in > $(DESTDIR)$(LIBDIR)/pkgconfig/libpcompress.pc
	@chmod 0444 $(DESTDIR)$(LIBDIR)/pkgconfig/libpcompress.pc

	@mkdir -p $(DESTDIR)$(PREFIX)/share/doc/$(PROG)
	@chmod 0755 $(DESTDIR)$(PREFIX)/share $(DESTDIR)$(PREFIX)/share/doc $(DESTDIR)$(PREFIX)/share/doc/$(PROG)
	@cp README.md $(DESTDIR)$(PREFIX)/share/doc/$(PROG)/README
	@chmod 0444 $(DESTDIR)$(PREFIX)/share/doc/$(PROG)/README

	@mkdir -p $(DESTDIR)$(PREFIX)/share/man/man1 $(DESTDIR)$(PREFIX)/share/man/man3
	@cp pcompress.1 $(DESTDIR)$(PREFIX)/share/man/man1/pcompress.1
	@chmod 0444 $(DESTDIR)$(PREFIX)/share/man/man1/pcompress.1
	@cp libpcompress.3 $(DESTDIR)$(PREFIX)/share/man/man3/libpcompress.3
	@chmod 0444 $(DESTDIR)$(PREFIX)/share/man/man3/libpcompress.3


