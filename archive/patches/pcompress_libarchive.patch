+/*
+ * Pcompress: when metadata streaming is on, give the filter a shadow copy
+ * (own buffers/position) through which all metadata reads are routed.
+ */
+int
+__archive_read_filter_add_shadow(struct archive_read *a,
+    struct archive_read_filter *filter)
+{
+	if (!a->archive.is_metadata_streaming)
+		return (ARCHIVE_OK);
+	filter->shadow = malloc(sizeof(*filter));
+	if (filter->shadow == NULL) {
+		archive_set_error(&a->archive, ENOMEM, "Out of memory");
+		return (ARCHIVE_FATAL);
+	}
+	memcpy(filter->shadow, filter, sizeof(*filter));
+	filter->shadow->shadow = NULL;
+	return (ARCHIVE_OK);
+}
